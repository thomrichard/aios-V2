# Agent utilisé pour les routines et les lancements sans discussion : claude, codex ou gemini
AGENT=claude

# Commande de lancement de chaque agent (modifiable)
CMD_CLAUDE="claude -p"
CMD_CODEX="codex exec"
CMD_GEMINI="gemini -p"

# Clés d'API : uniquement ici, jamais dans Git, jamais dans le chat
# OPENROUTER_API_KEY=
# KIT_API_KEY=          (systeme/scripts/kit.py : Kit, Settings, Developer, clé API v4)

# Dossier des fichiers lourds (vidéos, sons), hors du dépôt : un dossier Google Drive synchronisé, par exemple.
# systeme/scripts/ranger.py y range les vidéos et les sons ; verifier.py contrôle qu'il existe et s'écrit.
# FICHIERS_LOURDS=~/Google Drive/Mon Drive/aios-fichiers-lourds
